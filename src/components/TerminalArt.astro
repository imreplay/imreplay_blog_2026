---
import Icon from './Icon.astro';
---
<div class="terminal-art" aria-hidden="true">
  <div class="art-orbit orbit-one"></div><div class="art-orbit orbit-two"></div>
  <span class="orbit-point point-one"></span><span class="orbit-point point-two"></span>
  <span class="art-cross cross-one">+</span><span class="art-cross cross-two">+</span>
  <div class="terminal-window">
    <div class="terminal-bar"><div class="window-dots"><i></i><i></i><i></i></div><span>imreplay@workspace: ~</span><Icon name="terminal" size={13}/></div>
    <div class="terminal-body"><p><span class="prompt">❯</span> whoami</p><p class="terminal-answer">security researcher<span class="dim"> & </span>ctf player</p><p class="terminal-spacer"><span class="prompt">❯</span> cat philosophy.txt</p><p class="terminal-answer"><span class="dim">01</span> Question everything.</p><p class="terminal-answer"><span class="dim">02</span> Learn by doing.</p><p class="terminal-answer"><span class="dim">03</span> Share what you find.</p><p class="terminal-spacer"><span class="prompt">❯</span> <span class="cursor"></span></p></div>
  </div>
  <span class="art-label">ALWAYS LEARNING<span>↗</span></span>
</div>
