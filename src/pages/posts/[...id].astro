---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, withBase, formatDate, readingTime } from '../../lib/posts';
export async function getStaticPaths() { return (await getPosts()).filter(post => !post.data.externalUrl).map(post => ({ params: { id: post.id }, props: { post } })); }
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
---
<Base title={post.data.title} description={post.data.description} active="posts" article><div class="reading-progress" aria-hidden="true"></div><article class="article-page"><header class="article-header"><a class="back-link" href={withBase('posts/')}>← 모든 글</a><div class="post-eyebrow"><span class="category-label">{post.data.category}</span><span class="meta-separator">/</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span class="meta-separator">/</span><span>{readingTime(post.body)} min read</span></div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p><div class="article-author"><span class="mini-monogram">ir_</span><div><strong>imreplay</strong><span>Security Researcher</span></div></div></header><div class="article-grid"><div><div class="prose"><Content/></div><footer class="article-footer"><div class="post-tags">{post.data.tags.map(tag => <span>#{tag}</span>)}</div><a href={withBase('posts/')}>다른 기록 읽기 <Icon name="right" size={16}/></a></footer></div><aside class="table-of-contents"><h2>ON THIS PAGE</h2><nav aria-label="글 목차">{headings.filter(h => h.depth === 2).map(heading => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav><p>생각은 기록할 때<br/>조금 더 선명해집니다.</p></aside></div></article></Base>
